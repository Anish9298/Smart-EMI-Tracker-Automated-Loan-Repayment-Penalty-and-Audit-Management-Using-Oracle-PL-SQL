CREATE OR REPLACE FUNCTION FMT_RS(P_VALUE NUMBER)
RETURN VARCHAR2
DETERMINISTIC
IS
BEGIN
    RETURN 'Rs. ' || TO_CHAR(NVL(P_VALUE, 0), 'FM99,99,99,990.00');
END;
/

CREATE OR REPLACE FUNCTION CALCULATE_EMI(
    P_AMOUNT NUMBER,
    P_RATE   NUMBER,
    P_MONTHS NUMBER
)
RETURN NUMBER
IS
    V_RATE NUMBER;
    V_EMI  NUMBER;
BEGIN
    IF P_AMOUNT IS NULL OR P_RATE IS NULL OR P_MONTHS IS NULL
       OR P_AMOUNT <= 0 OR P_MONTHS <= 0 OR P_RATE < 0 THEN
        RAISE_APPLICATION_ERROR(-20001, 'Invalid loan details');
    END IF;

    V_RATE := P_RATE / 1200;

    IF V_RATE = 0 THEN
        V_EMI := P_AMOUNT / P_MONTHS;
    ELSE
        V_EMI := P_AMOUNT * V_RATE * POWER(1 + V_RATE, P_MONTHS)
                 / (POWER(1 + V_RATE, P_MONTHS) - 1);
    END IF;

    RETURN ROUND(V_EMI, 2);
END;
/


CREATE OR REPLACE TRIGGER EMI_AUDIT_TRIGGER
AFTER UPDATE OF EMI_STATUS ON EMI_SCHEDULE
FOR EACH ROW
WHEN (OLD.EMI_STATUS <> NEW.EMI_STATUS)
BEGIN
    INSERT INTO PAYMENT_AUDIT (AUDIT_ID, EMI_ID, OLD_STATUS, NEW_STATUS, CHANGE_DATE)
    VALUES (AUDIT_SEQ.NEXTVAL, :NEW.EMI_ID, :OLD.EMI_STATUS, :NEW.EMI_STATUS, SYSDATE);
END;
/

CREATE OR REPLACE TRIGGER EMI_PAYMENT_TRIGGER
AFTER INSERT ON EMI_PAYMENTS
FOR EACH ROW
BEGIN
    UPDATE EMI_SCHEDULE
    SET EMI_STATUS = 'PAID'
    WHERE EMI_ID = :NEW.EMI_ID;
END;
/


CREATE OR REPLACE PROCEDURE REGISTER_LOAN(
    P_CUSTOMER_ID IN  NUMBER,
    P_AMOUNT      IN  NUMBER,
    P_RATE        IN  NUMBER,
    P_MONTHS      IN  NUMBER,
    P_LOAN_ID     OUT NUMBER
)
IS
    V_CUSTOMER NUMBER;
    V_EMI      NUMBER;
BEGIN
    SELECT CUSTOMER_ID INTO V_CUSTOMER
    FROM CUSTOMERS
    WHERE CUSTOMER_ID = P_CUSTOMER_ID;

    V_EMI     := CALCULATE_EMI(P_AMOUNT, P_RATE, P_MONTHS);
    P_LOAN_ID := LOAN_SEQ.NEXTVAL;

    INSERT INTO LOANS (LOAN_ID, CUSTOMER_ID, LOAN_AMOUNT, INTEREST_RATE,
                       TENURE_MONTHS, MONTHLY_EMI, START_DATE, LOAN_STATUS)
    VALUES (P_LOAN_ID, P_CUSTOMER_ID, P_AMOUNT, P_RATE,
            P_MONTHS, V_EMI, TRUNC(SYSDATE), 'ACTIVE');

    DBMS_OUTPUT.PUT_LINE('Loan registered successfully');
    DBMS_OUTPUT.PUT_LINE('Loan ID     : ' || P_LOAN_ID);
    DBMS_OUTPUT.PUT_LINE('Monthly EMI : ' || FMT_RS(V_EMI));
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(-20004, 'Customer not found');
END;
/

CREATE OR REPLACE PROCEDURE GENERATE_EMI_SCHEDULE(P_LOAN_ID NUMBER)
IS
    V_MONTHS NUMBER;
    V_EMI    NUMBER;
    V_START  DATE;
    V_COUNT  NUMBER;
BEGIN
    SELECT TENURE_MONTHS, MONTHLY_EMI, START_DATE
    INTO V_MONTHS, V_EMI, V_START
    FROM LOANS
    WHERE LOAN_ID = P_LOAN_ID
      AND LOAN_STATUS = 'ACTIVE';

    SELECT COUNT(*) INTO V_COUNT
    FROM EMI_SCHEDULE
    WHERE LOAN_ID = P_LOAN_ID;

    IF V_COUNT > 0 THEN
        RAISE_APPLICATION_ERROR(-20006, 'Schedule already generated for this loan');
    END IF;

    FOR I IN 1 .. V_MONTHS LOOP
        INSERT INTO EMI_SCHEDULE (EMI_ID, LOAN_ID, EMI_NUMBER, DUE_DATE,
                                  EMI_AMOUNT, EMI_STATUS, PENALTY)
        VALUES (EMI_SEQ.NEXTVAL, P_LOAN_ID, I, ADD_MONTHS(V_START, I),
                V_EMI, 'PENDING', 0);
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('EMI schedule generated: ' || V_MONTHS || ' installments');
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(-20005, 'Active loan not found');
END;
/

CREATE OR REPLACE PROCEDURE MARK_OVERDUE_EMIS
IS
BEGIN
    UPDATE EMI_SCHEDULE
    SET EMI_STATUS = 'OVERDUE'
    WHERE EMI_STATUS = 'PENDING'
      AND DUE_DATE < TRUNC(SYSDATE);

    DBMS_OUTPUT.PUT_LINE('EMIs marked overdue: ' || SQL%ROWCOUNT);
END;
/

CREATE OR REPLACE PROCEDURE PAY_EMI(P_EMI_ID NUMBER)
IS
    V_LOAN_ID  NUMBER;
    V_EMI_NO   NUMBER;
    V_AMOUNT   NUMBER;
    V_DUE_DATE DATE;
    V_STATUS   VARCHAR2(20);
    V_UNPAID   NUMBER;
    V_DAYS_LATE NUMBER;
    V_PENALTY  NUMBER := 0;
    V_TOTAL    NUMBER;
BEGIN
    SELECT LOAN_ID, EMI_NUMBER, EMI_AMOUNT, DUE_DATE, EMI_STATUS
    INTO V_LOAN_ID, V_EMI_NO, V_AMOUNT, V_DUE_DATE, V_STATUS
    FROM EMI_SCHEDULE
    WHERE EMI_ID = P_EMI_ID
    FOR UPDATE;

    IF V_STATUS = 'PAID' THEN
        RAISE_APPLICATION_ERROR(-20002, 'EMI already paid');
    END IF;

    SELECT COUNT(*) INTO V_UNPAID
    FROM EMI_SCHEDULE
    WHERE LOAN_ID = V_LOAN_ID
      AND EMI_NUMBER < V_EMI_NO
      AND EMI_STATUS <> 'PAID';

    IF V_UNPAID > 0 THEN
        RAISE_APPLICATION_ERROR(-20007, 'Earlier EMIs are still unpaid');
    END IF;

    V_DAYS_LATE := TRUNC(SYSDATE) - TRUNC(V_DUE_DATE);

    IF V_DAYS_LATE > 0 THEN
        V_PENALTY := ROUND(V_AMOUNT * LEAST(V_DAYS_LATE * 0.001, 0.10), 2);
    END IF;

    V_TOTAL := V_AMOUNT + V_PENALTY;

    UPDATE EMI_SCHEDULE
    SET PENALTY = V_PENALTY
    WHERE EMI_ID = P_EMI_ID;

    INSERT INTO EMI_PAYMENTS (PAYMENT_ID, EMI_ID, PAYMENT_DATE, AMOUNT_PAID)
    VALUES (PAYMENT_SEQ.NEXTVAL, P_EMI_ID, SYSDATE, V_TOTAL);

    UPDATE LOANS
    SET LOAN_STATUS = 'CLOSED'
    WHERE LOAN_ID = V_LOAN_ID
      AND NOT EXISTS (SELECT 1 FROM EMI_SCHEDULE
                      WHERE LOAN_ID = V_LOAN_ID AND EMI_STATUS <> 'PAID');

    DBMS_OUTPUT.PUT_LINE('Payment successful');
    DBMS_OUTPUT.PUT_LINE('EMI Amount   : ' || FMT_RS(V_AMOUNT));
    DBMS_OUTPUT.PUT_LINE('Days Late    : ' || GREATEST(V_DAYS_LATE, 0));
    DBMS_OUTPUT.PUT_LINE('Late Penalty : ' || FMT_RS(V_PENALTY));
    DBMS_OUTPUT.PUT_LINE('Total Paid   : ' || FMT_RS(V_TOTAL));
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(-20003, 'EMI record not found');
END;
/

CREATE OR REPLACE PROCEDURE SHOW_PENDING_EMIS
IS
    V_FOUND BOOLEAN := FALSE;
BEGIN
    DBMS_OUTPUT.PUT_LINE('========== PENDING / OVERDUE EMI REPORT ==========');

    FOR R IN (
        SELECT C.CUSTOMER_NAME, L.LOAN_ID, E.EMI_ID, E.EMI_NUMBER,
               E.EMI_AMOUNT, E.DUE_DATE, E.EMI_STATUS
        FROM CUSTOMERS C
        JOIN LOANS L        ON C.CUSTOMER_ID = L.CUSTOMER_ID
        JOIN EMI_SCHEDULE E ON L.LOAN_ID = E.LOAN_ID
        WHERE E.EMI_STATUS IN ('PENDING', 'OVERDUE')
        ORDER BY E.DUE_DATE, E.EMI_ID
    ) LOOP
        V_FOUND := TRUE;
        DBMS_OUTPUT.PUT_LINE(
            R.CUSTOMER_NAME || ' | Loan ' || R.LOAN_ID ||
            ' | EMI ID ' || R.EMI_ID || ' (#' || R.EMI_NUMBER || ')' ||
            ' | ' || FMT_RS(R.EMI_AMOUNT) ||
            ' | Due ' || TO_CHAR(R.DUE_DATE, 'DD-MON-YYYY') ||
            ' | ' || R.EMI_STATUS);
    END LOOP;

    IF NOT V_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('No pending EMIs.');
    END IF;
END;
/

CREATE OR REPLACE PROCEDURE SHOW_PAYMENT_HISTORY(P_LOAN_ID NUMBER)
IS
    V_FOUND BOOLEAN := FALSE;
BEGIN
    DBMS_OUTPUT.PUT_LINE('========== PAYMENT HISTORY (Loan ' || P_LOAN_ID || ') ==========');

    FOR R IN (
        SELECT E.EMI_NUMBER, P.PAYMENT_DATE, E.EMI_AMOUNT, E.PENALTY, P.AMOUNT_PAID
        FROM EMI_PAYMENTS P
        JOIN EMI_SCHEDULE E ON P.EMI_ID = E.EMI_ID
        WHERE E.LOAN_ID = P_LOAN_ID
        ORDER BY E.EMI_NUMBER
    ) LOOP
        V_FOUND := TRUE;
        DBMS_OUTPUT.PUT_LINE(
            'EMI #' || R.EMI_NUMBER ||
            ' | Date: ' || TO_CHAR(R.PAYMENT_DATE, 'DD-MON-YYYY') ||
            ' | EMI: ' || FMT_RS(R.EMI_AMOUNT) ||
            ' | Penalty: ' || FMT_RS(R.PENALTY) ||
            ' | Paid: ' || FMT_RS(R.AMOUNT_PAID));
    END LOOP;

    IF NOT V_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('No payments found.');
    END IF;
END;
/

CREATE OR REPLACE PROCEDURE SHOW_LOAN_SUMMARY(P_LOAN_ID NUMBER)
IS
    V_NAME      CUSTOMERS.CUSTOMER_NAME%TYPE;
    V_AMOUNT    LOANS.LOAN_AMOUNT%TYPE;
    V_STATUS    LOANS.LOAN_STATUS%TYPE;
    V_PAID_CNT  NUMBER;
    V_LEFT_CNT  NUMBER;
    V_PAID_AMT  NUMBER;
    V_LEFT_AMT  NUMBER;
BEGIN
    SELECT C.CUSTOMER_NAME, L.LOAN_AMOUNT, L.LOAN_STATUS
    INTO V_NAME, V_AMOUNT, V_STATUS
    FROM LOANS L
    JOIN CUSTOMERS C ON C.CUSTOMER_ID = L.CUSTOMER_ID
    WHERE L.LOAN_ID = P_LOAN_ID;

    SELECT NVL(SUM(CASE WHEN EMI_STATUS = 'PAID' THEN 1 ELSE 0 END), 0),
           NVL(SUM(CASE WHEN EMI_STATUS <> 'PAID' THEN 1 ELSE 0 END), 0),
           NVL(SUM(CASE WHEN EMI_STATUS = 'PAID' THEN EMI_AMOUNT + PENALTY ELSE 0 END), 0),
           NVL(SUM(CASE WHEN EMI_STATUS <> 'PAID' THEN EMI_AMOUNT ELSE 0 END), 0)
    INTO V_PAID_CNT, V_LEFT_CNT, V_PAID_AMT, V_LEFT_AMT
    FROM EMI_SCHEDULE
    WHERE LOAN_ID = P_LOAN_ID;

    DBMS_OUTPUT.PUT_LINE('========== LOAN SUMMARY ==========');
    DBMS_OUTPUT.PUT_LINE('Customer       : ' || V_NAME);
    DBMS_OUTPUT.PUT_LINE('Loan ID        : ' || P_LOAN_ID || ' (' || V_STATUS || ')');
    DBMS_OUTPUT.PUT_LINE('Loan Amount    : ' || FMT_RS(V_AMOUNT));
    DBMS_OUTPUT.PUT_LINE('EMIs Paid      : ' || V_PAID_CNT);
    DBMS_OUTPUT.PUT_LINE('EMIs Remaining : ' || V_LEFT_CNT);
    DBMS_OUTPUT.PUT_LINE('Total Paid     : ' || FMT_RS(V_PAID_AMT));
    DBMS_OUTPUT.PUT_LINE('Remaining Due  : ' || FMT_RS(V_LEFT_AMT));
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RAISE_APPLICATION_ERROR(-20005, 'Loan not found');
END;
/

-- DEMONSTRATION

DECLARE
    V_LOAN_ID NUMBER;
    V_EMI_ID  NUMBER;
BEGIN
    REGISTER_LOAN(1, 500000, 10, 36, V_LOAN_ID);
    GENERATE_EMI_SCHEDULE(V_LOAN_ID);

    UPDATE EMI_SCHEDULE SET DUE_DATE = TRUNC(SYSDATE) - 5
    WHERE LOAN_ID = V_LOAN_ID AND EMI_NUMBER = 1;

    UPDATE EMI_SCHEDULE SET DUE_DATE = TRUNC(SYSDATE) - 1
    WHERE LOAN_ID = V_LOAN_ID AND EMI_NUMBER = 2;

    MARK_OVERDUE_EMIS;

    SELECT EMI_ID INTO V_EMI_ID
    FROM EMI_SCHEDULE
    WHERE LOAN_ID = V_LOAN_ID AND EMI_NUMBER = 1;

    PAY_EMI(V_EMI_ID);

    SHOW_PENDING_EMIS;
    SHOW_PAYMENT_HISTORY(V_LOAN_ID);
    SHOW_LOAN_SUMMARY(V_LOAN_ID);

    COMMIT;
END;
/


