SET SERVEROUTPUT ON SIZE UNLIMITED;
SET LINESIZE 200;
SET PAGESIZE 100;



BEGIN
    FOR T IN (SELECT TABLE_NAME FROM USER_TABLES
              WHERE TABLE_NAME IN ('EMI_PAYMENTS', 'PAYMENT_AUDIT', 'EMI_SCHEDULE', 'LOANS', 'CUSTOMERS')) LOOP
        EXECUTE IMMEDIATE 'DROP TABLE ' || T.TABLE_NAME || ' CASCADE CONSTRAINTS';
    END LOOP;

    FOR S IN (SELECT SEQUENCE_NAME FROM USER_SEQUENCES
              WHERE SEQUENCE_NAME IN ('CUSTOMER_SEQ', 'LOAN_SEQ', 'EMI_SEQ', 'PAYMENT_SEQ', 'AUDIT_SEQ')) LOOP
        EXECUTE IMMEDIATE 'DROP SEQUENCE ' || S.SEQUENCE_NAME;
    END LOOP;
END;
/

CREATE TABLE CUSTOMERS (
    CUSTOMER_ID   NUMBER PRIMARY KEY,
    CUSTOMER_NAME VARCHAR2(100) NOT NULL,
    PHONE         VARCHAR2(15),
    EMAIL         VARCHAR2(100)
);

CREATE TABLE LOANS (
    LOAN_ID       NUMBER PRIMARY KEY,
    CUSTOMER_ID   NUMBER NOT NULL REFERENCES CUSTOMERS(CUSTOMER_ID),
    LOAN_AMOUNT   NUMBER(12,2) NOT NULL CHECK (LOAN_AMOUNT > 0),
    INTEREST_RATE NUMBER(5,2)  NOT NULL CHECK (INTEREST_RATE >= 0),
    TENURE_MONTHS NUMBER       NOT NULL CHECK (TENURE_MONTHS > 0),
    MONTHLY_EMI   NUMBER(12,2) NOT NULL,
    START_DATE    DATE DEFAULT TRUNC(SYSDATE),
    LOAN_STATUS   VARCHAR2(20) DEFAULT 'ACTIVE' NOT NULL
                  CONSTRAINT CHK_LOAN_STATUS CHECK (LOAN_STATUS IN ('ACTIVE', 'CLOSED'))
);

CREATE TABLE EMI_SCHEDULE (
    EMI_ID     NUMBER PRIMARY KEY,
    LOAN_ID    NUMBER NOT NULL REFERENCES LOANS(LOAN_ID),
    EMI_NUMBER NUMBER NOT NULL,
    DUE_DATE   DATE   NOT NULL,
    EMI_AMOUNT NUMBER(12,2) NOT NULL,
    EMI_STATUS VARCHAR2(20) DEFAULT 'PENDING' NOT NULL
               CONSTRAINT CHK_EMI_STATUS CHECK (EMI_STATUS IN ('PENDING', 'OVERDUE', 'PAID')),
    PENALTY    NUMBER(10,2) DEFAULT 0 NOT NULL,
    CONSTRAINT UQ_LOAN_EMI UNIQUE (LOAN_ID, EMI_NUMBER)
);

CREATE TABLE EMI_PAYMENTS (
    PAYMENT_ID   NUMBER PRIMARY KEY,
    EMI_ID       NUMBER NOT NULL UNIQUE REFERENCES EMI_SCHEDULE(EMI_ID),
    PAYMENT_DATE DATE NOT NULL,
    AMOUNT_PAID  NUMBER(12,2) NOT NULL
);

CREATE TABLE PAYMENT_AUDIT (
    AUDIT_ID    NUMBER PRIMARY KEY,
    EMI_ID      NUMBER,
    OLD_STATUS  VARCHAR2(20),
    NEW_STATUS  VARCHAR2(20),
    CHANGE_DATE DATE
);

CREATE INDEX IDX_LOANS_CUSTOMER ON LOANS(CUSTOMER_ID);
CREATE INDEX IDX_EMI_STATUS_DUE ON EMI_SCHEDULE(EMI_STATUS, DUE_DATE);


